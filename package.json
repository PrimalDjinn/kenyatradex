{
  "name": "kenyatradex-nuxt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "validate:content": "node scripts/validate-content-integrity.mjs",
    "validate:seo": "node scripts/validate-seo-parity.mjs",
    "validate:routes": "node scripts/validate-route-parity.mjs",
    "test:calculator": "node --experimental-strip-types --test tests/import-duty.test.ts",
    "test:newsletter": "node --experimental-strip-types --test tests/newsletter.test.ts",
    "typecheck": "nuxi typecheck",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run validate:routes && pnpm run validate:content && pnpm run validate:seo && pnpm run test:calculator && pnpm run test:newsletter && pnpm run build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@chiballc/utils": "^2.2.14",
    "@electric-sql/pglite": "^0.3.16",
    "@nuxt/content": "^3.14.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.3",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.8.2",
    "@nuxthub/core": "^0.10.7",
    "consola": "^3.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.44.7",
    "nodemailer": "^6.10.1",
    "nuxt": "^4.4.8",
    "nuxt-studio": "^1.7.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.0",
    "std-env": "^4.1.0",
    "ufo": "^1.6.4",
    "ulid": "^3.0.2",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@types/nodemailer": "^6.4.24",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.3",
    "vue-tsc": "3.2.7"
  }
}
